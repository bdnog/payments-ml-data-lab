{
  "components": {
    "schemas": {
      "AccountBlock": {
        "properties": {
          "age_days": {
            "description": "Whole days since the account was opened.",
            "examples": [
              412
            ],
            "minimum": 0.0,
            "title": "Age Days",
            "type": "integer"
          },
          "id": {
            "examples": [
              "acc_33ba0290"
            ],
            "pattern": "^acc_[0-9a-f]{8}$",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "age_days"
        ],
        "title": "AccountBlock",
        "type": "object"
      },
      "BatchScoreItemResult": {
        "description": "The outcome for one item: exactly one of ``result`` and ``error`` is set.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProblemDetails"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "transaction_id": {
            "examples": [
              "txn_0a1b2c3d4e5f"
            ],
            "pattern": "^txn_[0-9a-f]{12}$",
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id"
        ],
        "title": "BatchScoreItemResult",
        "type": "object"
      },
      "BatchScoreRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScoreRequest"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "BatchScoreRequest",
        "type": "object"
      },
      "BatchScoreResponse": {
        "properties": {
          "results": {
            "description": "One entry per request item, in the same order.",
            "items": {
              "$ref": "#/components/schemas/BatchScoreItemResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "BatchScoreResponse",
        "type": "object"
      },
      "BehaviorBlock": {
        "description": "Velocity features, computed point-in-time by the caller: past data only.",
        "properties": {
          "avg_amount_30d_minor": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean amount (minor units) over the last 30 days; null if there is no history.",
            "examples": [
              18500
            ],
            "title": "Avg Amount 30D Minor"
          },
          "seconds_since_last_txn": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds since the account's previous transaction; null for the first.",
            "examples": [
              240
            ],
            "title": "Seconds Since Last Txn"
          },
          "txn_count_1h": {
            "description": "Account transactions in the last hour.",
            "examples": [
              3
            ],
            "minimum": 0.0,
            "title": "Txn Count 1H",
            "type": "integer"
          },
          "txn_count_24h": {
            "description": "Account transactions in the last 24 hours.",
            "examples": [
              5
            ],
            "minimum": 0.0,
            "title": "Txn Count 24H",
            "type": "integer"
          }
        },
        "required": [
          "txn_count_1h",
          "txn_count_24h",
          "avg_amount_30d_minor",
          "seconds_since_last_txn"
        ],
        "title": "BehaviorBlock",
        "type": "object"
      },
      "CardBlock": {
        "properties": {
          "bin": {
            "description": "First 6 digits of the card number.",
            "examples": [
              "912345"
            ],
            "pattern": "^[0-9]{6}$",
            "title": "Bin",
            "type": "string"
          },
          "is_new_for_merchant": {
            "description": "True when this account never used this card at this merchant before.",
            "examples": [
              true
            ],
            "title": "Is New For Merchant",
            "type": "boolean"
          },
          "issuer_country": {
            "examples": [
              "BR"
            ],
            "pattern": "^[A-Z]{2}$",
            "title": "Issuer Country",
            "type": "string"
          }
        },
        "required": [
          "bin",
          "issuer_country",
          "is_new_for_merchant"
        ],
        "title": "CardBlock",
        "type": "object"
      },
      "Channel": {
        "enum": [
          "web",
          "app",
          "pos"
        ],
        "title": "Channel",
        "type": "string"
      },
      "Currency": {
        "enum": [
          "BRL"
        ],
        "title": "Currency",
        "type": "string"
      },
      "Decision": {
        "enum": [
          "APPROVE",
          "REVIEW",
          "DECLINE"
        ],
        "title": "Decision",
        "type": "string"
      },
      "DeviceBlock": {
        "properties": {
          "id": {
            "description": "Device fingerprint; for in-person purchases, the terminal id.",
            "examples": [
              "dev_0a1b2c3d4e"
            ],
            "pattern": "^dev_[0-9a-f]{10}$",
            "title": "Id",
            "type": "string"
          },
          "ip_country": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Country of the client IP; null for in-person (pos) purchases.",
            "examples": [
              "RU"
            ],
            "title": "Ip Country"
          },
          "is_new_for_account": {
            "description": "True when this account never used this device before.",
            "examples": [
              true
            ],
            "title": "Is New For Account",
            "type": "boolean"
          },
          "is_proxy": {
            "description": "Whether the client IP looks like a proxy or VPN.",
            "examples": [
              true
            ],
            "title": "Is Proxy",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "ip_country",
          "is_proxy",
          "is_new_for_account"
        ],
        "title": "DeviceBlock",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Payload returned by every service's ``GET /health`` endpoint.",
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MerchantBlock": {
        "properties": {
          "id": {
            "examples": [
              "mer_5d7a1e"
            ],
            "pattern": "^mer_[0-9a-f]{6}$",
            "title": "Id",
            "type": "string"
          },
          "mcc": {
            "description": "Merchant category code.",
            "examples": [
              "5732"
            ],
            "pattern": "^[0-9]{4}$",
            "title": "Mcc",
            "type": "string"
          }
        },
        "required": [
          "id",
          "mcc"
        ],
        "title": "MerchantBlock",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Free-form numeric evaluation metrics.",
            "examples": [
              {
                "pr_auc": 0.41,
                "recall_at_1pct_fpr": 0.62
              }
            ],
            "title": "Metrics",
            "type": "object"
          },
          "model_version": {
            "examples": [
              "lgbm-baseline-0.1.0"
            ],
            "title": "Model Version",
            "type": "string"
          },
          "thresholds": {
            "$ref": "#/components/schemas/Thresholds"
          },
          "trained_at": {
            "examples": [
              "2026-02-01T03:00:00Z"
            ],
            "format": "date-time",
            "title": "Trained At",
            "type": "string"
          }
        },
        "required": [
          "model_version",
          "trained_at",
          "thresholds",
          "metrics"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An RFC 7807 problem, served as ``application/problem+json``.\n\nUsed for every error response of the HTTP services, including the ``501`` of routes that are\npart of a contract but not implemented yet.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explanation specific to this occurrence.",
            "examples": [
              "POST /v1/score is part of the v1 contract but is not implemented yet."
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Validation issues (field location, message, type); only on 422.",
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "URI reference of this occurrence.",
            "examples": [
              "/v1/score"
            ],
            "title": "Instance"
          },
          "status": {
            "description": "HTTP status code.",
            "examples": [
              501
            ],
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, human-readable summary.",
            "examples": [
              "Not Implemented"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "URI that identifies the kind of problem; 'about:blank' means 'see status'.",
            "examples": [
              "https://payments-ml-data-lab.example/problems/not-implemented"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReasonCode": {
        "description": "Positive reasons only: why the score is *high*. There are no codes for \"looked fine\".",
        "enum": [
          "NEW_DEVICE",
          "PROXY_DETECTED",
          "COUNTRY_MISMATCH",
          "AMOUNT_ABOVE_NORMAL",
          "HIGH_VELOCITY_1H",
          "HIGH_VELOCITY_24H",
          "NEW_ACCOUNT",
          "HIGH_RISK_MCC",
          "NEW_CARD_FOR_MERCHANT"
        ],
        "title": "ReasonCode",
        "type": "string"
      },
      "ScoreRequest": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountBlock"
          },
          "amount_minor": {
            "description": "Amount in minor units (centavos), never a float.",
            "examples": [
              89900
            ],
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "behavior": {
            "$ref": "#/components/schemas/BehaviorBlock"
          },
          "card": {
            "$ref": "#/components/schemas/CardBlock"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel",
            "examples": [
              "web"
            ]
          },
          "currency": {
            "$ref": "#/components/schemas/Currency",
            "examples": [
              "BRL"
            ]
          },
          "device": {
            "$ref": "#/components/schemas/DeviceBlock"
          },
          "installments": {
            "examples": [
              1
            ],
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Installments",
            "type": "integer"
          },
          "merchant": {
            "$ref": "#/components/schemas/MerchantBlock"
          },
          "occurred_at": {
            "description": "When the transaction was attempted; must carry a timezone.",
            "examples": [
              "2026-01-12T22:41:07.512345Z"
            ],
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "transaction_id": {
            "examples": [
              "txn_0a1b2c3d4e5f"
            ],
            "pattern": "^txn_[0-9a-f]{12}$",
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "occurred_at",
          "amount_minor",
          "currency",
          "channel",
          "installments",
          "merchant",
          "card",
          "device",
          "account",
          "behavior"
        ],
        "title": "ScoreRequest",
        "type": "object"
      },
      "ScoreResponse": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision",
            "examples": [
              "DECLINE"
            ]
          },
          "latency_ms": {
            "description": "Server-side scoring time.",
            "examples": [
              4.2
            ],
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "model_version": {
            "examples": [
              "lgbm-baseline-0.1.0"
            ],
            "title": "Model Version",
            "type": "string"
          },
          "reason_codes": {
            "description": "Why the score is high. Empty for clearly legitimate transactions.",
            "examples": [
              [
                "NEW_DEVICE",
                "PROXY_DETECTED",
                "AMOUNT_ABOVE_NORMAL"
              ]
            ],
            "items": {
              "$ref": "#/components/schemas/ReasonCode"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "score": {
            "description": "Fraud probability-like score.",
            "examples": [
              0.93
            ],
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "transaction_id": {
            "examples": [
              "txn_0a1b2c3d4e5f"
            ],
            "pattern": "^txn_[0-9a-f]{12}$",
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "score",
          "decision",
          "model_version",
          "reason_codes",
          "latency_ms"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "Thresholds": {
        "properties": {
          "decline": {
            "description": "Scores at or above this are declined.",
            "examples": [
              0.85
            ],
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Decline",
            "type": "number"
          },
          "review": {
            "description": "Scores at or above this go to review.",
            "examples": [
              0.5
            ],
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Review",
            "type": "number"
          }
        },
        "required": [
          "review",
          "decline"
        ],
        "title": "Thresholds",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Online fraud scoring. **v1 contract**: the caller sends the transaction together with its\nprecomputed `behavior` features. Only `/health` is implemented; the `/v1` routes answer `501`.\n",
    "title": "risk-scoring-api",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/model": {
      "get": {
        "operationId": "get_model",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not implemented"
          }
        },
        "summary": "Describe the model in production",
        "tags": [
          "model"
        ]
      }
    },
    "/v1/score": {
      "post": {
        "description": "Score one transaction.\n\nThe caller sends the transaction plus its `behavior` block (velocity features computed\npoint-in-time: only past data, the current transaction excluded).\n\n**Idempotent by `transaction_id`.** Sending the same payload again returns the same decision.\nSending the same `transaction_id` with a *different* payload returns `409`.\n\nValidation errors return `422`. All errors are `application/problem+json`.",
        "operationId": "score",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation error"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not implemented"
          }
        },
        "summary": "Score one transaction",
        "tags": [
          "scoring"
        ]
      }
    },
    "/v1/score:batch": {
      "post": {
        "description": "Each item is scored independently and gets either a result or an error, in request order. A bad item does not fail the batch. The same idempotency rule as `/v1/score` applies.",
        "operationId": "score_batch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Validation error"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not implemented"
          }
        },
        "summary": "Score up to 100 transactions",
        "tags": [
          "scoring"
        ]
      }
    }
  }
}
