# Copy to `.env` and adjust. Never commit `.env`. All values are synthetic/local-only.

# --- Postgres (used by later phases) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_PORT=5432

# --- Redis (used by later phases) ---
REDIS_PORT=6379

# --- risk-scoring-api ---
RISK_APP_VERSION=0.1.0
RISK_LOG_LEVEL=INFO
RISK_API_PORT=8001
# Uvicorn workers and torch threads per worker (inference is CPU-bound: scale with workers).
RISK_WEB_CONCURRENCY=1
RISK_TORCH_THREADS=1
# Optional overrides of the thresholds stored in the model artifact (review <= decline):
# RISK_THRESHOLD_REVIEW=0.11
# RISK_THRESHOLD_DECLINE=0.99
# Used when running the API outside Docker (make run-risk); compose sets its own.
# RISK_DATABASE_URL=postgresql+psycopg://payments:payments@localhost:5432/risk_scoring

# --- settlement-service ---
SETTLEMENT_APP_VERSION=0.1.0
SETTLEMENT_LOG_LEVEL=INFO
SETTLEMENT_API_PORT=8002

# Business date used by `docker compose run --rm settlement-batch` (YYYY-MM-DD)
SETTLEMENT_RUN_DATE=2026-11-10
