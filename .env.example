# Copy to `.env` and adjust. Never commit `.env`. All values are synthetic/local-only.

# --- Postgres (used by later phases) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
POSTGRES_PORT=5432

# --- Redis (used by later phases) ---
REDIS_PORT=6379

# --- risk-scoring-api ---
RISK_APP_VERSION=0.1.0
RISK_LOG_LEVEL=INFO
RISK_API_PORT=8001

# --- settlement-service ---
SETTLEMENT_APP_VERSION=0.1.0
SETTLEMENT_LOG_LEVEL=INFO
SETTLEMENT_API_PORT=8002
